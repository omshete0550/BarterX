PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NODE_ENV=development
COOKIE_SAME_SITE=lax
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com

# Dedicated non-production services for the destructive E2E suite.
RUN_E2E=false
E2E_MONGO_URI=your_test_mongodb_connection_string
E2E_CLOUDINARY_CLOUD_NAME=your_test_cloud_name
E2E_CLOUDINARY_API_KEY=your_test_api_key
E2E_CLOUDINARY_API_SECRET=your_test_api_secret
E2E_CLOUDINARY_FOLDER=barterx/e2e
